{
    "name": "@dooc-dev/dooc",
    "version": "0.0.10",
    "description": "View and edit source files with dooc.yaml configuration, and share them as source ZIPs or standalone HTML.",
    "license": "MIT",
    "type": "module",
    "files": [
        "dist"
    ],
    "bin": {
        "dooc": "./dist/server/cli.js"
    },
    "exports": {
        "./check": {
            "types": "./dist/engine/compiler/check.d.ts",
            "default": "./dist/engine/compiler/check.js"
        },
        "./viewer-plugins": {
            "types": "./dist/server/plugins.d.ts",
            "default": "./dist/server/plugins.js"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "default": "./dist/plugins/index.js"
        },
        ".": {
            "types": "./dist/server/index.d.ts",
            "default": "./dist/server/index.js"
        },
        "./flow": {
            "types": "./dist/frontend/schema-graph-mount.d.ts",
            "default": "./dist/frontend/schema-graph-mount.js"
        },
        "./flow.global.js": "./dist/flow.global.js",
        "./build": {
            "types": "./dist/server/build.d.ts",
            "default": "./dist/server/build.js"
        },
        "./export": {
            "types": "./dist/engine/compiler/export.d.ts",
            "default": "./dist/engine/compiler/export.js"
        }
    },
    "peerDependencies": {
        "@xyflow/react": ">=12",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "peerDependenciesMeta": {
        "@xyflow/react": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "packageManager": "pnpm@10.28.2",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:plugin": "pnpm --dir plugins run build",
        "test:plugin-package": "node --import tsx scripts/test/plugin-package.mjs",
        "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && pnpm run build:css && tsc -p tsconfig.build.json && node scripts/build/flatten-dist.mjs && node scripts/build/self-assets.mjs && pnpm run build:fonts && pnpm run build:flow && pnpm run build:edit && pnpm run build:client",
        "build:binary": "bun scripts/build/binary.mjs",
        "build:css": "node --import tsx scripts/build/flow-css.ts",
        "build:flow": "esbuild packages/frontend/src/schema-graph-global.tsx --bundle --format=iife --target=es2022 --minify --outfile=dist/flow.global.js && esbuild packages/frontend/src/schema-graph-global.tsx --bundle --splitting --format=esm --target=es2022 --minify --outdir=dist/graph",
        "build:edit": "esbuild packages/frontend/src/edit-client.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/edit.global.js && esbuild packages/frontend/src/ui-client.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/ui.global.js && esbuild packages/frontend/src/code-highlight.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/code.global.js && esbuild packages/frontend/src/code-worker.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/code-worker.global.js && esbuild packages/frontend/src/published-plugins.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/plugins.global.js && esbuild packages/frontend/src/published-subformats.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/subformats.global.js",
        "dooc": "cd \"$INIT_CWD\" && node --import tsx \"$PNPM_SCRIPT_SRC_DIR/packages/server/src/cli.ts\"",
        "dev": "tsx watch --clear-screen=false packages/server/src/cli.ts",
        "test": "vitest run",
        "test:binary": "node scripts/test/binary.mjs",
        "test:install": "node scripts/test/install.mjs",
        "check": "biome check . && tsc --noEmit && pnpm run build && vitest run && pnpm run test:install && pnpm run test:plugin-package",
        "fix": "biome check --write .",
        "build:fonts": "node -e \"require('node:fs').cpSync('packages/server/src/fonts', 'dist/server/fonts', {recursive:true})\"",
        "build:sample-extension": "node --import tsx scripts/build/sample-extension.mjs",
        "build:client": "node scripts/build/client.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lint": "6.9.7",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/common": "^1.5.4",
        "@lezer/highlight": "^1.2.5",
        "@noble/hashes": "^2.4.0",
        "@shikijs/themes": "^4.5.0",
        "@types/dxf": "4.6.10",
        "@types/mdast": "^4.0.4",
        "@types/node": "^22.10.0",
        "@types/path-browserify": "^1.0.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/ws": "^8.18.2",
        "@xyflow/react": "^12.11.2",
        "buffer": "^6.0.3",
        "diff": "8.0.4",
        "esbuild": "^0.28.1",
        "events": "^3.3.0",
        "isomorphic-git": "^1.44.13",
        "memfs": "^4.80.0",
        "mermaid": "12.3.0",
        "path-browserify": "^1.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "readable-stream": "^4.8.0",
        "textlint": "^15.8.0",
        "tsx": "^4.19.2",
        "typescript": "^5.8.3",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "@clack/prompts": "1.9.0",
        "@dagrejs/dagre": "^3.0.0",
        "@shikijs/langs": "4.5.0",
        "@textlint/kernel": "^15.8.0",
        "@textlint/module-interop": "^15.8.0",
        "@textlint/textlint-plugin-markdown": "^15.8.0",
        "ajv": "8.20.0",
        "ajv-formats": "3.0.1",
        "dxf": "5.3.1",
        "fflate": "^0.8.3",
        "franc": "^6.2.0",
        "ignore": "^7.0.14",
        "iso-639-3": "^3.0.1",
        "parse5": "8.0.0",
        "postcss": "8.5.32",
        "postcss-value-parser": "4.2.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-stringify": "11.0.0",
        "shiki": "^4.5.0",
        "smol-toml": "1.9.1",
        "string-width": "4.2.3",
        "textlint-rule-preset-ja-technical-writing": "^12.0.2",
        "toml-eslint-parser": "^0.10.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "vscode-json-languageservice": "5.7.2",
        "vscode-languageserver-textdocument": "1.0.16",
        "ws": "^8.22.2",
        "yaml": "^2.7.0"
    },
    "pnpm": {
        "overrides": {
            "mermaid@12.3.0>elkjs": "-"
        },
        "patchedDependencies": {
            "mermaid@12.3.0": "patches/mermaid@12.3.0.patch"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dooc-dev/dooc.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
