{
    "name": "@dooc-dev/dooc",
    "version": "0.0.4",
    "description": "View and edit source files with dooc.yaml configuration, and share them as source ZIPs or standalone HTML.",
    "type": "module",
    "files": [
        "dist"
    ],
    "bin": {
        "dooc": "./dist/cli.js"
    },
    "exports": {
        "./check": {
            "types": "./dist/compiler/check.d.ts",
            "default": "./dist/compiler/check.js"
        },
        "./viewer-plugins": {
            "types": "./dist/viewer/plugins.d.ts",
            "default": "./dist/viewer/plugins.js"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "default": "./dist/plugins/index.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./flow": {
            "types": "./dist/core/schema-graph-mount.d.ts",
            "default": "./dist/core/schema-graph-mount.js"
        },
        "./flow.global.js": "./dist/flow.global.js"
    },
    "peerDependencies": {
        "@xyflow/react": ">=12",
        "react": ">=19",
        "react-dom": ">=19"
    },
    "peerDependenciesMeta": {
        "@xyflow/react": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "packageManager": "pnpm@10.28.2",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:plugin": "node -e \"require('node:fs').rmSync('packages/dooc-plugin/dist', {recursive:true, force:true})\" && tsc -p tsconfig.plugin.json",
        "test:plugin-package": "node --import tsx scripts/test-plugin-package.mjs",
        "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && pnpm run build:css && pnpm run build:fonts && tsc -p tsconfig.build.json && pnpm run build:flow && pnpm run build:edit",
        "build:binary": "bun scripts/build-binary.mjs",
        "build:css": "node --import tsx src/core/build-flow-css.ts",
        "build:flow": "esbuild src/core/schema-graph-global.tsx --bundle --format=iife --target=es2022 --minify --outfile=dist/flow.global.js",
        "build:edit": "esbuild src/viewer/edit-client.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/edit.global.js && esbuild src/viewer/ui-client.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/ui.global.js && esbuild src/viewer/code-highlight.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/code.global.js",
        "test": "vitest run",
        "test:binary": "node scripts/test-binary.mjs",
        "test:install": "node scripts/test-install.mjs",
        "check": "biome check . && tsc --noEmit && pnpm run build && vitest run && pnpm run test:install && pnpm run test:plugin-package",
        "fix": "biome check --write .",
        "build:fonts": "node -e \"require('node:fs').cpSync('src/viewer/fonts', 'dist/viewer/fonts', {recursive:true})\"",
        "build:sample-extension": "node --import tsx scripts/build-sample-extension.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lint": "6.9.7",
        "@codemirror/search": "6.7.2",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/common": "^1.5.4",
        "@lezer/highlight": "^1.2.5",
        "@shikijs/themes": "^4.5.0",
        "@types/mdast": "^4.0.4",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@xyflow/react": "^12.11.2",
        "diff": "8.0.4",
        "esbuild": "^0.28.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "textlint": "^15.8.0",
        "tsx": "^4.19.2",
        "typescript": "^5.8.3",
        "vitest": "^2.1.9"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.0.0",
        "@shikijs/langs": "4.5.0",
        "@textlint/kernel": "^15.8.0",
        "@textlint/module-interop": "^15.8.0",
        "@textlint/textlint-plugin-markdown": "^15.8.0",
        "franc": "^6.2.0",
        "iso-639-3": "^3.0.1",
        "mermaid": "^12.3.0",
        "parse5": "8.0.0",
        "postcss": "8.5.32",
        "postcss-value-parser": "4.2.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-stringify": "11.0.0",
        "shiki": "^4.5.0",
        "string-width": "4.2.3",
        "textlint-rule-preset-ja-technical-writing": "^12.0.2",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.0.0",
        "yaml": "^2.7.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dooc-dev/dooc.git"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    }
}
