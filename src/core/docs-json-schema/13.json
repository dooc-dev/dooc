{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:dooc:docs-json-schema:13",
    "title": "docs.json — generation 13",
    "description": "Distributed document bundle. Documents are ordered in manifest pre-order; parent holds the hierarchy. Figure markup is fetched separately from figures/<name>.json (see definitions/FigureEntry).",
    "type": "object",
    "additionalProperties": false,
    "required": ["generation", "docs", "terms", "figures"],
    "properties": {
        "title": {
            "type": "string",
            "minLength": 1
        },
        "generation": {
            "type": "integer",
            "const": 13
        },
        "docs": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/ArtifactDoc"
            }
        },
        "figures": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/FigureIndexEntry"
            }
        },
        "terms": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/TermEntry"
            }
        }
    },
    "definitions": {
        "Strings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "StringRows": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/Strings"
            }
        },
        "DocId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "FigureName": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "FigureIndexEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "file", "kind"],
            "properties": {
                "name": {
                    "$ref": "#/definitions/FigureName"
                },
                "file": {
                    "type": "string",
                    "description": "Source path relative to the docs root, e.g. figures/overview.svg."
                },
                "kind": {
                    "enum": ["svg", "html", "image"]
                },
                "title": {
                    "type": "string"
                },
                "desc": {
                    "type": "string"
                }
            }
        },
        "FigureEntry": {
            "description": "Separate figures/<name>.json payload. Markup is SVG, HTML, or an img element with a data URI; it requires appropriate isolation when rendered.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "file", "kind", "markup"],
            "properties": {
                "name": {
                    "$ref": "#/definitions/FigureName"
                },
                "file": {
                    "type": "string"
                },
                "kind": {
                    "enum": ["svg", "html", "image"]
                },
                "title": {
                    "type": "string"
                },
                "desc": {
                    "type": "string"
                },
                "markup": {
                    "type": "string"
                }
            }
        },
        "ArtifactDoc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "file", "title", "lang", "body", "blocks", "toc", "refs"],
            "properties": {
                "id": {
                    "$ref": "#/definitions/DocId"
                },
                "parent": {
                    "$ref": "#/definitions/DocId"
                },
                "file": {
                    "type": "string",
                    "description": "Source path: content/<id>.md."
                },
                "title": {
                    "type": "string"
                },
                "tags": {
                    "$ref": "#/definitions/Strings"
                },
                "description": {
                    "type": "string"
                },
                "lang": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
                    "description": "Resolved BCP 47 language tag, including ISO 639-3 primary tags."
                },
                "icon": {
                    "type": "string",
                    "description": "Full SVG content of the optional sidebar icon."
                },
                "body": {
                    "type": "string",
                    "description": "Markdown source without front-matter. Rendering uses blocks."
                },
                "blocks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Block"
                    }
                },
                "toc": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/TocEntry"
                    }
                },
                "refs": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["figures", "terms"],
                    "properties": {
                        "figures": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/FigureName"
                            }
                        },
                        "terms": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "pattern": "^[a-z0-9][a-z0-9_-]*$"
                            }
                        }
                    }
                }
            }
        },
        "TocEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["depth", "text", "slug"],
            "properties": {
                "depth": {
                    "enum": [1, 2, 3]
                },
                "text": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                }
            }
        },
        "ListItem": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "children"],
                    "properties": {
                        "text": {
                            "type": "string"
                        },
                        "children": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ListItem"
                            }
                        },
                        "ordered": {
                            "type": "boolean"
                        }
                    }
                }
            ]
        },
        "Paragraph": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
                "type": {
                    "const": "p"
                },
                "text": {
                    "type": "string"
                }
            }
        },
        "List": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "items"],
            "properties": {
                "type": {
                    "const": "list"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ListItem"
                    }
                },
                "ordered": {
                    "type": "boolean"
                }
            }
        },
        "CalloutItem": {
            "oneOf": [
                {
                    "$ref": "#/definitions/Paragraph"
                },
                {
                    "$ref": "#/definitions/List"
                }
            ]
        },
        "Block": {
            "description": "Normalized body AST. Inline strings keep `code`, [text](url), and explicit :::term(id) references.",
            "oneOf": [
                {
                    "$ref": "#/definitions/Paragraph"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "level", "text", "slug"],
                    "properties": {
                        "type": {
                            "const": "h"
                        },
                        "level": {
                            "enum": [1, 2, 3]
                        },
                        "text": {
                            "type": "string"
                        },
                        "slug": {
                            "type": "string"
                        }
                    }
                },
                {
                    "$ref": "#/definitions/List"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "lines"],
                    "properties": {
                        "type": {
                            "const": "code"
                        },
                        "lines": {
                            "$ref": "#/definitions/Strings"
                        },
                        "lang": {
                            "type": "string",
                            "description": "An open language identifier; custom fence labels are allowed."
                        },
                        "filename": {
                            "type": "string",
                            "description": "Docs-root-relative path or HTTP(S) URL of an embedded UTF-8 file."
                        },
                        "range": {
                            "type": "string",
                            "description": "Inclusive [start, end] selector for an embedded file. The selected content is already stored in lines."
                        },
                        "unavailable": {
                            "enum": ["missing", "unreachable"],
                            "description": "Graceful placeholder when the referenced source cannot be loaded."
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "headers", "rows"],
                    "properties": {
                        "type": {
                            "const": "table"
                        },
                        "headers": {
                            "$ref": "#/definitions/Strings"
                        },
                        "rows": {
                            "$ref": "#/definitions/StringRows"
                        },
                        "caption": {
                            "type": "string"
                        },
                        "collapsible": {
                            "type": "boolean"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "body"],
                    "properties": {
                        "type": {
                            "const": "callout"
                        },
                        "title": {
                            "type": "string"
                        },
                        "body": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/CalloutItem"
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "name"],
                    "properties": {
                        "type": {
                            "const": "figureRef"
                        },
                        "name": {
                            "$ref": "#/definitions/FigureName"
                        },
                        "caption": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "entry"],
                    "properties": {
                        "type": {
                            "const": "term"
                        },
                        "entry": {
                            "$ref": "#/definitions/TermEntry"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": {
                        "type": {
                            "const": "figures"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "graph"],
                    "properties": {
                        "type": {
                            "const": "schemaGraph"
                        },
                        "caption": {
                            "type": "string"
                        },
                        "graph": {
                            "$ref": "#/definitions/SchemaModel"
                        },
                        "source": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "graph"],
                    "properties": {
                        "type": {
                            "const": "graph"
                        },
                        "caption": {
                            "type": "string"
                        },
                        "graph": {
                            "$ref": "#/definitions/GraphModel"
                        },
                        "source": {
                            "type": "string"
                        }
                    }
                }
            ]
        },
        "SchemaField": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
                "name": {
                    "type": "string"
                },
                "kind": {
                    "enum": ["pk", "fk", "fkList", "scalar"]
                },
                "type": {
                    "type": "string",
                    "description": "Scalar type or the display label of an enum."
                },
                "targets": {
                    "$ref": "#/definitions/Strings"
                }
            }
        },
        "SchemaTable": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fields", "notes"],
            "properties": {
                "name": {
                    "type": "string"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/SchemaField"
                    }
                },
                "notes": {
                    "$ref": "#/definitions/Strings"
                },
                "pk": {
                    "$ref": "#/definitions/Strings"
                },
                "unique": {
                    "$ref": "#/definitions/StringRows"
                }
            }
        },
        "SchemaGroup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tables"],
            "properties": {
                "label": {
                    "type": "string"
                },
                "tables": {
                    "$ref": "#/definitions/Strings"
                }
            }
        },
        "SchemaEdge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "fieldIndex", "field", "to", "list"],
            "properties": {
                "from": {
                    "type": "string"
                },
                "fieldIndex": {
                    "type": "integer",
                    "minimum": 0
                },
                "field": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "list": {
                    "type": "boolean"
                }
            }
        },
        "SchemaModel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["groups", "tables", "edges"],
            "properties": {
                "groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/SchemaGroup"
                    }
                },
                "tables": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/SchemaTable"
                    }
                },
                "edges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/SchemaEdge"
                    }
                }
            }
        },
        "GraphNode": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
                "id": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "region": {
                    "type": "string"
                }
            }
        },
        "GraphEdge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind"],
            "properties": {
                "from": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                },
                "kind": {
                    "enum": ["solid", "dashed", "undirected"]
                },
                "label": {
                    "type": "string"
                }
            }
        },
        "GraphRegion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodes"],
            "properties": {
                "label": {
                    "type": "string"
                },
                "nodes": {
                    "$ref": "#/definitions/Strings"
                }
            }
        },
        "GraphModel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodes", "edges", "regions"],
            "properties": {
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/GraphNode"
                    }
                },
                "edges": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/GraphEdge"
                    }
                },
                "regions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/GraphRegion"
                    }
                }
            }
        },
        "TermEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "definition"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "definition": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                }
            }
        }
    }
}
