{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Planned",
        "Ready",
        "Shipped"
      ],
      "title": "Status"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version"
    },
    "due": {
      "type": "string",
      "format": "date",
      "title": "Release date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Low",
        "Normal",
        "High"
      ]
    },
    "owner": {
      "$ref": "#/$defs/person"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "passed",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "risk": {
      "type": "object",
      "properties": {
        "likelihood": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "mitigation": {
          "type": "string",
          "minLength": 10
        }
      },
      "required": [
        "likelihood",
        "impact",
        "mitigation"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "title",
    "status",
    "version",
    "due",
    "priority",
    "owner",
    "artifacts",
    "risk"
  ],
  "additionalProperties": false,
  "$defs": {
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "Binary",
            "Container",
            "Documentation"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "kind",
        "url",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "title": "Desktop 2.4 release candidate",
      "status": "Ready",
      "version": "2.4.0",
      "due": "2026-11-18",
      "priority": "High",
      "owner": {
        "name": "Release team",
        "email": "release@example.org"
      },
      "artifacts": [
        {
          "name": "Desktop installer",
          "kind": "Binary",
          "url": "https://example.org/releases/2.4.0/desktop.zip",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "name": "Migration guide",
          "kind": "Documentation",
          "url": "https://example.org/releases/2.4.0/guide",
          "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "checks": [
        {
          "name": "Upgrade from previous release",
          "passed": true,
          "evidence": "https://example.org/checks/upgrade-24"
        },
        {
          "name": "Offline installation",
          "passed": false,
          "evidence": "https://example.org/checks/offline-24"
        }
      ],
      "risk": {
        "likelihood": 2,
        "impact": 4,
        "mitigation": "Keep the previous installer available for rollback."
      },
      "labels": [
        "desktop",
        "migration"
      ]
    }
  ]
}
