{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Running",
        "Review",
        "Complete"
      ],
      "title": "Status"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 20
    },
    "started": {
      "type": "string",
      "format": "date",
      "title": "Started"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "title": "Confidence"
    },
    "effort": {
      "type": "integer",
      "minimum": 1,
      "title": "Effort"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "primary_metric": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "allocation": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "name",
              "allocation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "primary_metric",
        "variants"
      ],
      "additionalProperties": false
    },
    "results": {
      "$ref": "#/$defs/results"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Notebook",
              "Dataset",
              "Report"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "kind",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "status",
    "hypothesis",
    "started",
    "confidence",
    "effort",
    "owners",
    "design"
  ],
  "additionalProperties": false,
  "$defs": {
    "person": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "properties": {
        "sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "effect": {
          "type": "number"
        },
        "interval": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "sample_size",
        "effect",
        "interval"
      ],
      "additionalProperties": false
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "Complete"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "results"
    ],
    "properties": {
      "results": {
        "$ref": "#/$defs/results"
      }
    }
  },
  "examples": [
    {
      "title": "Compare compact and detailed cards",
      "status": "Running",
      "hypothesis": "A compact summary helps people find the next task more quickly.",
      "started": "2026-11-09",
      "confidence": 0.62,
      "effort": 5,
      "owners": [
        {
          "name": "Research team",
          "email": "research@example.org"
        },
        {
          "name": "Design team",
          "email": "design@example.org"
        }
      ],
      "design": {
        "primary_metric": "Median time to select a task",
        "variants": [
          {
            "name": "Compact",
            "allocation": 0.5
          },
          {
            "name": "Detailed",
            "allocation": 0.5
          }
        ]
      },
      "assets": [
        {
          "kind": "Notebook",
          "url": "https://example.org/research/card-density"
        }
      ]
    }
  ]
}
