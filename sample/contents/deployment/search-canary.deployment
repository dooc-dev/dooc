title = "Production search service canary"
status = "Rolling out"
environment = "Production"
scheduled = "2026-11-12T03:00:00Z"
approved = true
region = "ap-northeast"
replicas = 6

[strategy]
mode = "Canary"
batch_size = 1
health_path = "/health/ready"

[[services]]
name = "search"
image = "example/search:2.4.0"
port = 8080

[services.resources]
cpu = 2
memory_mib = 2048

[[services]]
name = "indexer"
image = "example/indexer:1.8.1"
port = 9090

[services.resources]
cpu = 1
memory_mib = 1024

[rollback]
image = "example/search:2.3.2"
automatic = true
timeout_seconds = 180
