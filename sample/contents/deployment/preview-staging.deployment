title = "Staging preview service update"
status = "Staged"
environment = "Staging"
scheduled = "2026-11-13T01:30:00Z"
approved = false
region = "eu-west"
replicas = 2

[strategy]
mode = "Blue-green"
batch_size = 2
health_path = "/ready"

[[services]]
name = "preview"
image = "example/preview:3.0.0-rc1"
port = 8080

[services.resources]
cpu = 0.5
memory_mib = 512

[rollback]
image = "example/preview:2.9.0"
automatic = false
timeout_seconds = 120
