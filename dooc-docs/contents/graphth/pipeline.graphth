[manifest]: dooc.yaml @Workspace
[schemas]: JSON Schemas @Workspace
[records]: Record files @Workspace
[script]: records.mjs @Pipeline
[json]: records.json @Pipeline
[deploy]: Deploy jobs @Pipeline
[bundle]: bundle.html @Pipeline

[manifest] -> [script]: ext, format, schema
[schemas] -> [script]: validate
[records] -> [script]: parse
[script] -> [json]
[json] -> [deploy]: matrix
[manifest] --> [bundle]: dooc build
