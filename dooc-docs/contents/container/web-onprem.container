name: Web (on-premise)
tier: Frontend
runtime: Docker host
image: registry.example.org/fieldnotes/web:2.4.1
network: contents/vpc/prod-onprem.vpc
subnet: app
team: contents/team/docs.team
resources:
  cpu: 1
  memory_mb: 1024
replicas:
  min: 2
  max: 2
ports:
  - 8443
depends_on:
  - contents/container/api-onprem.container
logs: contents/log/application.log
