{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime definitions",
  "description": "Definitions shared by every runtime record type. The same shape describes cloud and on-premise systems.",
  "$defs": {
    "provider": {
      "title": "Provider",
      "type": "string",
      "enum": ["Cloud", "On-premise"]
    },
    "environment": {
      "title": "Environment",
      "type": "string",
      "enum": ["Production", "Staging", "Development"]
    },
    "cidr": {
      "title": "CIDR",
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "port": { "title": "Port", "type": "integer", "minimum": 1, "maximum": 65535 },
    "image": {
      "title": "Image",
      "description": "Container image with an explicit tag.",
      "type": "string",
      "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+$"
    },
    "resources": {
      "title": "Resources",
      "type": "object",
      "required": ["cpu", "memory_mb"],
      "properties": {
        "cpu": { "type": "number", "exclusiveMinimum": 0, "title": "CPU cores" },
        "memory_mb": { "type": "integer", "minimum": 64, "title": "Memory (MiB)" },
        "disk_gb": { "type": "integer", "minimum": 1, "title": "Disk (GiB)" }
      },
      "additionalProperties": false
    },
    "replicas": {
      "title": "Replicas",
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "dependency": {
      "title": "Dependency",
      "description": "A container or datastore this workload calls.",
      "anyOf": [
        { "$ref": "container.schema.json#/$defs/ref" },
        { "$ref": "datastore.schema.json#/$defs/ref" }
      ]
    }
  }
}
