{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Note",
  "type": "object",
  "required": ["title", "kind", "date", "team", "body"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "title": "Title" },
    "kind": { "type": "string", "enum": ["Meeting", "Decision", "Memo"], "title": "Kind" },
    "date": { "type": "string", "format": "date", "title": "Date" },
    "team": { "$ref": "team.schema.json#/$defs/ref" },
    "project": { "$ref": "project.schema.json#/$defs/ref" },
    "milestone": { "$ref": "milestone.schema.json#/$defs/ref" },
    "issues": {
      "type": "array",
      "title": "Issues",
      "uniqueItems": true,
      "items": { "$ref": "issue.schema.json#/$defs/ref" }
    },
    "attendees": {
      "type": "array",
      "title": "Attendees",
      "uniqueItems": true,
      "items": { "$ref": "team.schema.json#/$defs/member_id" }
    },
    "body": { "type": "string", "minLength": 1, "title": "Body" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "title": "New note",
      "kind": "Memo",
      "date": "2026-11-13",
      "team": "contents/team/docs.team",
      "body": "Write the note here."
    }
  ]
}
